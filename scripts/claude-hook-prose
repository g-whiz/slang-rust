#!/usr/bin/env bash
set -euo pipefail

if [[ $# -gt 0 ]]; then
    printf '%s\n' "usage: claude-hook-prose < hook-input.json" "" \
        "Claude Code PostToolUse hook. Reads the hook input JSON on stdin and, when" \
        "tool_input.file_path ends in .md or .rs and resolves to a file inside the" \
        "repository, runs just check-prose on that file. A relative path is joined to" \
        "the cwd field of the input, or to the repository root when cwd is absent." \
        "Input that is not a JSON object, or that lacks the path, is ignored. Prints" \
        "the findings to stderr and exits 2 when there are findings. When the checker" \
        "fails for another reason, such as a Rust file that cannot be lexed while it is" \
        "being edited, prints its message to stderr and exits 1, which does not block."
    [[ "$1" == "-h" || "$1" == "--help" ]] && exit 0
    exit 2
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

file_path="$(python3 -I -c '
import json
import os
import sys

root = sys.argv[1]
try:
    payload = json.load(sys.stdin)
except ValueError as error:
    print(f"claude-hook-prose: invalid hook input JSON: {error}", file=sys.stderr)
    sys.exit(1)
if not isinstance(payload, dict):
    sys.exit(0)
tool_input = payload.get("tool_input")
if not isinstance(tool_input, dict):
    sys.exit(0)
path = tool_input.get("file_path")
if not isinstance(path, str) or not path or "\0" in path:
    sys.exit(0)
base = payload.get("cwd")
if not isinstance(base, str) or "\0" in base or not os.path.isabs(base):
    base = root
path = os.path.join(base, path)
real_root = os.path.realpath(root)
if os.path.commonpath([real_root, os.path.realpath(path)]) != real_root:
    sys.exit(0)
print(path)
' "${root}")"

[[ "${file_path}" == *.md || "${file_path}" == *.rs ]] || exit 0

cd "${root}"

status=0
findings="$(just check-prose "${file_path}" 2>&1)" || status=$?

if [[ ${status} -eq 1 ]]; then
    printf '%s\n' "${findings}" >&2
    exit 2
fi
if [[ ${status} -ne 0 ]]; then
    printf '%s\n' "${findings}" >&2
    exit 1
fi

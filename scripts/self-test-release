rm "${tree}/README.md"
pack a 0.1.0 "${case_dir}/crates/a-0.1.0.crate"
expect "check-package without README.md" 1 "holds no README.md as a regular file" "" "${scripts}/check-package" "${site}" a

new_case
good_package
tree="$(crate_tree a 0.1.0)"
rm "${tree}/LICENSE-MIT"
ln -s ../../LICENSE-MIT "${tree}/LICENSE-MIT"
pack a 0.1.0 "${case_dir}/crates/a-0.1.0.crate"
expect "check-package with a licence file as a link" 1 "holds no LICENSE-MIT as a regular file" "" "${scripts}/check-package" "${site}" a

new_case

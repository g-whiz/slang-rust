crate_tree g 0.1.0 >/dev/null
pack g 0.1.0 "${case_dir}/crates/g-0.1.0.crate"
expect "check-package with an unknown licence" 1 "no licence file is known for the licence 'GPL-3.0-only'" "" "${scripts}/check-package" "${site}" g

new_case
good_package

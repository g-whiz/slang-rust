shared_versions() {
    metadata "a|$1|MIT OR Apache-2.0||null" "slang-src|0.1.0-slang.1|Apache-2.0 WITH LLVM-exception||null" "b|$2|MIT OR Apache-2.0||null"
}

new_case
printf 'notes\n' >"${case_dir}/notes"
expect "tag-release without packages" 2 "usage: tag-release" "" "${scripts}/tag-release" "${case_dir}/notes"


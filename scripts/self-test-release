tree="$(crate_tree s 0.1.0-x)"
rm "${tree}/LICENSE-APACHE" "${tree}/LICENSE-MIT"
cp "${case_dir}/LICENSE-APACHE-LLVM" "${tree}/LICENSE"
pack s 0.1.0-x "${case_dir}/crates/s-0.1.0-x.crate"
expect "check-package with the licence of Slang" 0 "licence: LICENSE equals LICENSE-APACHE-LLVM" "" "${scripts}/check-package" "${site}" s

new_case

mkdir -p "${tree}/target/debug" "${tree}/.git"
printf 'x\n' >"${tree}/target/debug/out"
printf 'x\n' >"${tree}/.git/HEAD"
pack a 0.1.0 "${case_dir}/crates/a-0.1.0.crate"
expect "check-package with a path under target" 1 "holds a-0.1.0/target/debug/out, which is under a directory named target or .git" "" "${scripts}/check-package" "${site}" a
check_output "check-package with a path under .git" "holds a-0.1.0/.git/HEAD, which is under a directory named target or .git"

new_case
good_package

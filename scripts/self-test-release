#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf '%s\n' "usage: self-test-release" "" \
        "Runs scripts/check-package, check-release, check-doc-site, publish-dry-run," \
        "publish, tag-release, and yank against stubs of cargo, git, gh, curl, sleep," \
        "and date in a temporary directory, and runs the recipes publish-dry-run, publish," \
        "and tag-release through just on a copy of the justfile and those scripts in" \
        "that directory. It fails unless each case gives its expected exit status," \
        "message, and calls of the stubs. It resolves just to its absolute path first" \
        "and calls it by that path, because just can be installed in a directory that" \
        "also holds the real cargo. PATH then holds only the stubs, /usr/bin, and /bin," \
        "and the run stops before any case when just is not installed, when a program" \
        "that the scripts run is not in /usr/bin or /bin, when cargo, git, gh, curl," \
        "sleep, or date does not resolve to its stub, or when any other program named cargo is" \
        "on PATH, so no case can reach crates.io or GitHub." \
        "Exits 1 when a case fails, and 2 when the setup is broken."
}

if [[ $# -gt 0 ]]; then
    usage
    [[ "$1" == "-h" || "$1" == "--help" ]] && exit 0
    exit 2
fi

scripts="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
work="$(mktemp -d)"
trap 'rm -rf -- "${work}"' EXIT
stubs="${work}/stubs"
mkdir -p "${stubs}"

cat >"${stubs}/cargo" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'cargo %s\n' "$*" >>"${STUB_LOG}"
case "$1" in
    metadata) cat "${STUB_METADATA}" ;;
    package)
        if [[ "$2" == "--list" ]]; then
            printf 'files of %s\n' "$4"
        else
            mkdir -p "${STUB_TARGET}/package"
            cp "${STUB_CRATES}"/*.crate "${STUB_TARGET}/package/"
        fi
        ;;
    publish)
        if [[ "$4" == "${STUB_CARGO_SIGNAL_ON:-}" ]]; then
            kill -s "${STUB_CARGO_SIGNAL}" "${PPID}"
            kill -s "${STUB_CARGO_SIGNAL}" "$$"
        fi
        if [[ "$4" == "${STUB_CARGO_UPLOADED_THEN_FAILS:-}" ]]; then
            if [[ -f "${STUB_LOG}.uploaded-$4" ]]; then
                printf 'error: crate %s@0.1.0 already exists on crates.io index\n' "$4" >&2
                exit 101
            fi
            : >"${STUB_LOG}.uploaded-$4"
            key="$(printf '%s' "https://crates.io/api/v1/crates/$4/0.1.0" | tr '/:' '__')"
            if [[ -z "${STUB_CARGO_UPLOAD_LOST:-}" ]]; then
                printf '200' >"${STUB_WEB}/${key}.status"
            fi
            printf '   Uploading %s\n    Uploaded %s v0.1.0 to registry `crates-io`\n' "$4" "$4" >&2
            if [[ "${STUB_CARGO_FAILURE_AFTER_UPLOAD}" == cdn ]]; then
                printf 'warning: spurious network error (3 tries remaining): failed to get successful HTTP response from `https://index.crates.io/1/%s`, got 429\nbody:\n<title>429 Too Many Requests</title>\nerror: failed to query replaced source registry `crates-io`\n' "$4" >&2
            else
                printf 'error: failed to query replaced source registry `crates-io`\n' >&2
            fi
            exit 101
        fi
        state="${STUB_LOG}.refused"
        limit="${STUB_CARGO_RATE_LIMITED:-0}"
        if [[ -n "${STUB_CARGO_RATE_LIMITED_EACH:-}" ]]; then
            state="${STUB_LOG}.refused-$4"
            limit="${STUB_CARGO_RATE_LIMITED_EACH}"
        fi
        refused=0
        if [[ -f "${state}" ]]; then
            refused="$(cat "${state}")"
        fi
        if [[ "${refused}" -lt "${limit}" ]]; then
            printf '%s\n' "$((refused + 1))" >"${state}"
            detail="You have published too many new crates in a short period of time."
            if [[ -n "${STUB_RETRY_AFTER:-}" ]]; then
                detail="You have published too many new crates in a short period of time. Please try again after ${STUB_RETRY_AFTER} and see https://crates.io/docs/rate-limits for more details."
            fi
            printf 'error: failed to publish %s to registry at https://crates.io\n\nCaused by:\n  the remote server responded with an error (status 429 Too Many Requests): %s\n' "$4" "${detail}" >&2
            exit 101
        fi
        if [[ "${STUB_CARGO_STATUS:-0}" -ne 0 ]]; then
            printf 'error: failed to publish %s\n' "$4" >&2
            exit "${STUB_CARGO_STATUS}"
        fi
        printf '   Uploading %s\n' "$4" >&2
        ;;
    yank) exit "${STUB_CARGO_STATUS:-0}" ;;
esac
EOF

cat >"${stubs}/git" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'git %s\n' "$*" >>"${STUB_LOG}"
case "$1 ${3:-}" in
    "status "*) printf '%s' "${STUB_GIT_STATUS:-}" ;;
    "fetch "*) exit "${STUB_GIT_FETCH_STATUS:-0}" ;;
    "rev-parse HEAD") printf '%s\n' "${STUB_HEAD}" ;;
    "rev-parse refs/remotes/origin/main") printf '%s\n' "${STUB_MAIN}" ;;
esac
EOF

cat >"${stubs}/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'gh %s\n' "$*" >>"${STUB_LOG}"
EOF

cat >"${stubs}/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
output=""
url=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --output) output="$2"; shift 2 ;;
        --proto | --user-agent | --write-out | --retry | --connect-timeout | --max-time) shift 2 ;;
        -*) shift ;;
        *) url="$1"; shift ;;
    esac
done
printf 'curl %s\n' "${url}" >>"${STUB_LOG}"
if [[ "${STUB_CURL_STATUS:-0}" -ne 0 ]]; then
    printf 'curl: (6) Could not resolve host: crates.io\n' >&2
    exit "${STUB_CURL_STATUS}"
fi
key="$(printf '%s' "${url}" | tr '/:' '__')"
status=404
if [[ -f "${STUB_WEB}/${key}.status" ]]; then
    status="$(cat "${STUB_WEB}/${key}.status")"
fi
if [[ -f "${STUB_WEB}/${key}" ]]; then
    cp "${STUB_WEB}/${key}" "${output}"
else
    : >"${output}"
fi
printf '%s' "${status}"
EOF

cat >"${stubs}/sleep" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'sleep %s\n' "$*" >>"${STUB_LOG}"
if [[ $# -ne 1 || ! "$1" =~ ^[0-9]+$ || "$1" -le 0 ]]; then
    printf 'sleep: invalid time interval %s\n' "$*" >&2
    exit 1
fi
EOF

cat >"${stubs}/date" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == "-u +%s" && -n "${STUB_NOW:-}" ]]; then
    printf '%s\n' "${STUB_NOW}"
    exit 0
fi
exec /usr/bin/date "$@"
EOF

chmod +x "${stubs}"/*
if ! just_program="$(command -v just)" || [[ "${just_program}" != /* ]]; then
    printf 'self-test-release: just is not installed, so the cases that run the recipes through just cannot run\n' >&2
    exit 2
fi
export PATH="${stubs}:/usr/bin:/bin"
for tool in bash env python3 awk cat cmp cp cut diff dirname du find grep gzip head ln mkdir mktemp rm sed sort tail tar tee tr wc; do
    if ! command -v "${tool}" >/dev/null 2>&1; then
        printf 'self-test-release: %s is not in /usr/bin or /bin, so the cases cannot run\n' "${tool}" >&2
        exit 2
    fi
done
for tool in cargo git gh curl sleep date; do
    if [[ "$(command -v "${tool}")" != "${stubs}/${tool}" ]]; then
        printf 'self-test-release: %s does not resolve to its stub, so the cases do not run\n' "${tool}" >&2
        exit 2
    fi
done
if [[ ! -x /usr/bin/date ]]; then
    printf 'self-test-release: /usr/bin/date does not exist, so the stub of date cannot pass its calls on\n' >&2
    exit 2
fi
if [[ "$(type -ap cargo)" != "${stubs}/cargo" ]]; then
    printf 'self-test-release: a program named cargo other than the stub is on PATH, so the cases do not run\n' >&2
    exit 2
fi
unset GITHUB_ACTIONS CARGO_REGISTRY_TOKEN CARGO_TARGET_DIR STUB_NOW STUB_RETRY_AFTER

site="https://example.invalid/docs"
head_commit=1111111111111111111111111111111111111111
other_commit=2222222222222222222222222222222222222222

failures=0
cases=0
case_dir=""

new_case() {
    cases=$((cases + 1))
    case_dir="${work}/case-${cases}"
    mkdir -p "${case_dir}/web" "${case_dir}/crates" "${case_dir}/target"
    printf 'Apache text\n' >"${case_dir}/LICENSE-APACHE"
    printf 'MIT text\n' >"${case_dir}/LICENSE-MIT"
    printf 'LLVM text\n' >"${case_dir}/LICENSE-APACHE-LLVM"
    printf 'GPL text\n' >"${case_dir}/LICENSE-GPL"
    : >"${case_dir}/log"
    export STUB_LOG="${case_dir}/log"
    export STUB_METADATA="${case_dir}/metadata.json"
    export STUB_TARGET="${case_dir}/target"
    export STUB_CRATES="${case_dir}/crates"
    export STUB_WEB="${case_dir}/web"
    export STUB_HEAD="${head_commit}"
    export STUB_MAIN="${head_commit}"
    export STUB_GIT_STATUS=""
    export STUB_GIT_FETCH_STATUS=0
    export STUB_CARGO_STATUS=0
    export STUB_CARGO_RATE_LIMITED=0
    export STUB_CURL_STATUS=0
}

metadata() {
    local entries=() entry
    for entry in "$@"; do
        local name version licence documentation publish
        IFS='|' read -r name version licence documentation publish <<<"${entry}"
        entries+=("{\"name\": \"${name}\", \"version\": \"${version}\", \"license\": \"${licence}\", \"documentation\": \"${documentation}\", \"publish\": ${publish}}")
    done
    local joined
    joined="$(printf '%s,' "${entries[@]}")"
    printf '{"target_directory": "%s", "packages": [%s]}\n' "${case_dir}/target" "${joined%,}" >"${STUB_METADATA}"
}

crate_tree() {
    local tree="${case_dir}/src/$1-$2"
    mkdir -p "${tree}/src"
    printf 'fn main() {}\n' >"${tree}/src/lib.rs"
    printf 'readme\n' >"${tree}/README.md"
    cp "${case_dir}/LICENSE-APACHE" "${tree}/LICENSE-APACHE"
    cp "${case_dir}/LICENSE-MIT" "${tree}/LICENSE-MIT"
    printf '%s\n' "${tree}"
}

pack() {
    tar -czf "$3" -C "${case_dir}/src" "$1-$2"
}

web() {
    local key
    key="$(printf '%s' "$1" | tr '/:' '__')"
    printf '%s' "$2" >"${STUB_WEB}/${key}.status"
    if [[ $# -ge 3 ]]; then
        cp "$3" "${STUB_WEB}/${key}"
    fi
}

expect() {
    local name="$1" status="$2" message="$3" log="$4"
    shift 4
    local actual=0
    (cd "${case_dir}" && "$@") >"${case_dir}/stdout" 2>"${case_dir}/stderr" || actual=$?
    local problems=()
    if [[ "${actual}" -ne "${status}" ]]; then
        problems+=("exit status ${actual}, expected ${status}")
    fi
    if [[ -n "${message}" ]] && ! grep -qF -- "${message}" "${case_dir}/stdout" "${case_dir}/stderr"; then
        problems+=("no output holds '${message}'")
    fi
    if [[ -n "${log}" ]] && ! grep -qxF -- "${log}" "${case_dir}/log"; then
        problems+=("the stubs were not called with '${log}'")
    fi
    if [[ "${#problems[@]}" -ne 0 ]]; then
        failures=$((failures + 1))
        printf 'FAIL %s\n' "${name}"
        printf '    %s\n' "${problems[@]}"
        sed 's/^/    stdout: /' "${case_dir}/stdout"
        sed 's/^/    stderr: /' "${case_dir}/stderr"
        sed 's/^/    calls: /' "${case_dir}/log"
    fi
}

check_output() {
    if ! grep -qF -- "$2" "${case_dir}/stdout" "${case_dir}/stderr"; then
        failures=$((failures + 1))
        printf 'FAIL %s\n    no output holds %s\n' "$1" "$2"
    fi
}

check_call() {
    if ! grep -qxF -- "$2" "${case_dir}/log"; then
        failures=$((failures + 1))
        printf 'FAIL %s\n    the stubs were not called with %s\n' "$1" "$2"
    fi
}

expect_no_call() {
    if grep -qE -- "$2" "${case_dir}/log"; then
        failures=$((failures + 1))
        printf 'FAIL %s\n    the stubs were called with %s\n' "$1" "$2"
    fi
}

record() {
    mkdir -p "${case_dir}/target"
    printf 'commit=%s\npackages=%s\n' "$1" "$2" >"${case_dir}/target/publish-dry-run.commit"
}

new_case
expect "publish without packages" 2 "usage: CARGO_REGISTRY_TOKEN" "" "${scripts}/publish"

new_case
GITHUB_ACTIONS=true CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish on a runner" 1 "GITHUB_ACTIONS is set" "" "${scripts}/publish" a
expect_no_call "publish on a runner" '^(cargo|git) '

new_case
GITHUB_ACTIONS="" CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish with an empty GITHUB_ACTIONS" 1 "GITHUB_ACTIONS is set" "" "${scripts}/publish" a

new_case
expect "publish without a token" 1 "CARGO_REGISTRY_TOKEN is unset or empty" "" "${scripts}/publish" a
expect_no_call "publish without a token" '^cargo '

new_case
CARGO_REGISTRY_TOKEN="" expect "publish with an empty token" 1 "CARGO_REGISTRY_TOKEN is unset or empty" "" "${scripts}/publish" a

new_case
STUB_GIT_STATUS=" M Cargo.toml" CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish with a change" 1 "uncommitted changes or untracked files" "" "${scripts}/publish" a
expect_no_call "publish with a change" '^cargo '

new_case
STUB_GIT_FETCH_STATUS=1 CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish when the fetch fails" 1 "git fetch of origin main failed" "" "${scripts}/publish" a

new_case
STUB_MAIN="${other_commit}" CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish behind origin/main" 1 "differs from origin/main" "git fetch --quiet origin main" "${scripts}/publish" a
expect_no_call "publish behind origin/main" '^cargo '

new_case
CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish without a dry run" 1 "does not exist, so run just publish-dry-run" "" "${scripts}/publish" a

new_case
record "${other_commit}" "a b"
CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish after a dry run of another commit" 1 "recorded the commit '${other_commit}'" "" "${scripts}/publish" a b
expect_no_call "publish after a dry run of another commit" '^cargo '

new_case
record "${head_commit}" "a b"
CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish other packages than the dry run" 1 "recorded the packages 'a b', not 'b'" "" "${scripts}/publish" b
expect_no_call "publish other packages than the dry run" '^cargo '

publish_case() {
    new_case
    record "${head_commit}" "$*"
    local entries=() name
    for name in "$@"; do
        entries+=("${name}|0.1.0|MIT OR Apache-2.0||null")
    done
    metadata "${entries[@]}"
}

published_before() {
    local name
    for name in "$@"; do
        web "${api}/${name}/0.1.0" 200
        web "${api}/${name}" 200
    done
}

expect_calls() {
    local actual
    actual="$(grep -cxF -- "$3" "${case_dir}/log" || true)"
    if [[ "${actual}" -ne "$2" ]]; then
        failures=$((failures + 1))
        printf 'FAIL %s\n    the stubs were called %s times with %s, expected %s\n' "$1" "${actual}" "$3" "$2"
    fi
}

expect_order() {
    local first second
    first="$(grep -nxF -- "$2" "${case_dir}/log" | head -n 1 | cut -d : -f 1)" || first=""
    second="$(grep -nxF -- "$3" "${case_dir}/log" | head -n 1 | cut -d : -f 1)" || second=""
    if [[ -z "${first}" || -z "${second}" || "${first}" -ge "${second}" ]]; then
        failures=$((failures + 1))
        printf 'FAIL %s\n    the stubs were not called with %s before %s\n' "$1" "$2" "$3"
    fi
}

api="https://crates.io/api/v1/crates"

publish_case a b
CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish after the dry run" 0 "2 published in this run, 0 already there" "cargo publish --no-verify -p a" "${scripts}/publish" a b
expect_order "publish after the dry run publishes in order" "cargo publish --no-verify -p a" "cargo publish --no-verify -p b"
check_output "publish after the dry run shows the output of cargo" "Uploading b"
check_output "publish after the dry run names a new crate" "a 0.1.0 is a new crate on crates.io"
check_call "publish after the dry run asks crates.io for the version" "curl ${api}/a/0.1.0"
check_call "publish after the dry run asks crates.io for the crate" "curl ${api}/a"
expect_no_call "publish after the dry run waits for no rate limit" '^sleep [0-9]{2,}$'

publish_case a b c d e f
CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish of more new crates than the burst" 0 "6 published in this run" "cargo publish --no-verify -p f" "${scripts}/publish" a b c d e f
expect_calls "publish of more new crates than the burst" 1 "sleep 600"
expect_order "publish of more new crates than the burst waits after the fifth" "cargo publish --no-verify -p e" "sleep 600"
expect_order "publish of more new crates than the burst waits before the sixth" "sleep 600" "cargo publish --no-verify -p f"
check_output "publish of more new crates than the burst says why it waits" "waiting 600 s before the new crate f 0.1.0"

publish_case a b
web "${api}/a/0.1.0" 404
web "${api}/a" 200
CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish of a new version" 0 "a 0.1.0 is a new version of a crate on crates.io" "cargo publish --no-verify -p a" "${scripts}/publish" a b
check_output "publish of a new version tells it from a new crate" "b 0.1.0 is a new crate on crates.io"

publish_case a b
published_before a
CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish of a version that exists" 0 "a 0.1.0 is already on crates.io and is skipped" "cargo publish --no-verify -p b" "${scripts}/publish" a b
expect_no_call "publish of a version that exists" '^cargo publish --no-verify -p a$'
check_output "publish of a version that exists counts it" "1 published in this run, 1 already there"

publish_case a
published_before a
CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish when every version exists" 0 "0 published in this run, 1 already there" "" "${scripts}/publish" a
expect_no_call "publish when every version exists" '^cargo publish'

read -r -a partial_names <<<"slang-bindgen slang-src slang-compiler-sys slang-glslang-sys slang-compiler slango slango-codegen slango-macros"
publish_case "${partial_names[@]}"
published_before "${partial_names[@]:0:5}"
CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish after a partial publish" 0 "3 published in this run, 5 already there" "cargo publish --no-verify -p slango-macros" "${scripts}/publish" "${partial_names[@]}"
for name in "${partial_names[@]:0:5}"; do
    expect_no_call "publish after a partial publish skips ${name}" "^cargo publish --no-verify -p ${name}\$"
    check_output "publish after a partial publish names ${name}" "${name} 0.1.0 is already on crates.io and is skipped"
done
expect_order "publish after a partial publish publishes in order" "cargo publish --no-verify -p slango" "cargo publish --no-verify -p slango-codegen"
expect_no_call "publish after a partial publish waits for no rate limit" '^sleep [0-9]{2,}$'

publish_case a b
STUB_NOW=1800000000 STUB_RETRY_AFTER="Fri, 15 Jan 2027 08:02:00 GMT" STUB_CARGO_RATE_LIMITED=1 CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish refused for the rate limit once" 0 "2 published in this run" "sleep 125" "${scripts}/publish" a b
expect_calls "publish refused for the rate limit once retries" 2 "cargo publish --no-verify -p a"
expect_order "publish refused for the rate limit once waits before the retry" "sleep 125" "cargo publish --no-verify -p b"
expect_order "publish refused for the rate limit once then paces" "sleep 125" "sleep 600"
expect_order "publish refused for the rate limit once paces the next crate" "sleep 600" "cargo publish --no-verify -p b"
check_output "publish refused for the rate limit once says why it waits" "refused the new crate a 0.1.0 for its rate limit, so waiting 125 s before retry 1 of 3"

publish_case a b
STUB_CARGO_RATE_LIMITED=10 CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish refused for the rate limit past the retries" 101 "still refuses the new crate a 0.1.0 for its rate limit after 3 retries" "" "${scripts}/publish" a b
expect_calls "publish refused for the rate limit past the retries" 4 "cargo publish --no-verify -p a"
expect_calls "publish refused for the rate limit past the retries waits the interval" 3 "sleep 600"
expect_no_call "publish refused for the rate limit past the retries" '^cargo publish --no-verify -p b$'
check_output "publish refused for the rate limit past the retries names the rest" "not published: a b"

publish_case a b
published_before a
STUB_CARGO_STATUS=101 CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish that cargo fails" 101 "cargo publish of b 0.1.0 failed with status 101" "cargo publish --no-verify -p b" "${scripts}/publish" a b
expect_calls "publish that cargo fails does not retry" 1 "cargo publish --no-verify -p b"
check_output "publish that cargo fails names the published" "already on crates.io before this run: a"
check_output "publish that cargo fails names the rest" "not published: b"

publish_case a b
STUB_CURL_STATUS=6 CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish when crates.io is unreachable" 1 "cannot reach ${api}/a/0.1.0, so nothing was published" "" "${scripts}/publish" a b
expect_no_call "publish when crates.io is unreachable" '^cargo publish'

publish_case a b
web "${api}/b/0.1.0" 500
CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish when crates.io fails" 1 "answered with HTTP status 500, so nothing was published" "" "${scripts}/publish" a b
expect_no_call "publish when crates.io fails" '^cargo publish'

publish_case a c
metadata "a|0.1.0|MIT OR Apache-2.0||null"
CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish of a package that is not a member" 1 "c is not a member of the workspace" "" "${scripts}/publish" a c
expect_no_call "publish of a package that is not a member" '^cargo publish'

expect_empty_tmp() {
    if [[ -n "$(ls -A "${case_dir}/tmp")" ]]; then
        failures=$((failures + 1))
        printf 'FAIL %s\n    the temporary directory holds %s\n' "$1" "$(ls -A "${case_dir}/tmp")"
    fi
}

with_default_signals() {
    python3 -I -c '
import os, signal, sys
signal.signal(signal.SIGINT, signal.SIG_DFL)
signal.signal(signal.SIGTERM, signal.SIG_DFL)
os.execv(sys.argv[1], sys.argv[1:])
' "$@"
}

publish_case a b
STUB_NOW=1800000000 STUB_RETRY_AFTER="Fri, 15 Jan 2027 07:00:00 GMT" STUB_CARGO_RATE_LIMITED=1 CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish refused until a time in the past" 0 "2 published in this run" "sleep 60" "${scripts}/publish" a b
check_output "publish refused until a time in the past waits a tenth of the interval" "so waiting 60 s before retry 1 of 3"

publish_case a b
STUB_NOW=1800000000 STUB_RETRY_AFTER="Fri, 15 Jan 2027 09:00:00 GMT" STUB_CARGO_RATE_LIMITED=1 CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish refused until a time beyond the bound" 101 "until Fri, 15 Jan 2027 09:00:00 GMT, which is more than 1205 s away" "" "${scripts}/publish" a b
expect_calls "publish refused until a time beyond the bound does not retry" 1 "cargo publish --no-verify -p a"
expect_no_call "publish refused until a time beyond the bound does not wait" '^sleep [0-9]{2,}$'
check_output "publish refused until a time beyond the bound names the rest" "not published: a b"

publish_case a b
STUB_CARGO_RATE_LIMITED_EACH=3 CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish of two packages each refused three times" 0 "2 published in this run" "cargo publish --no-verify -p b" "${scripts}/publish" a b
expect_calls "publish of two packages each refused three times retries the first" 4 "cargo publish --no-verify -p a"
expect_calls "publish of two packages each refused three times retries the second" 4 "cargo publish --no-verify -p b"

publish_case a b
mkdir -p "${case_dir}/tmp"
TMPDIR="${case_dir}/tmp" CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish removes its temporary directory" 0 "2 published in this run" "" "${scripts}/publish" a b
expect_empty_tmp "publish removes its temporary directory"

publish_case a b
mkdir -p "${case_dir}/tmp"
STUB_CARGO_STATUS=101 TMPDIR="${case_dir}/tmp" CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish that fails removes its temporary directory" 101 "failed with status 101" "" "${scripts}/publish" a b
expect_empty_tmp "publish that fails removes its temporary directory"

for failure in cdn plain; do
    publish_case a b
    STUB_CARGO_UPLOADED_THEN_FAILS=a STUB_CARGO_FAILURE_AFTER_UPLOAD="${failure}" CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish that cargo fails after the upload, ${failure}" 0 "2 published in this run" "cargo publish --no-verify -p b" "${scripts}/publish" a b
    check_output "publish that cargo fails after the upload, ${failure}, says so" "cargo publish of a 0.1.0 failed with status 101, but crates.io holds that version"
    expect_calls "publish that cargo fails after the upload, ${failure}, does not retry" 1 "cargo publish --no-verify -p a"
    expect_no_call "publish that cargo fails after the upload, ${failure}, does not wait" '^sleep [0-9]{2,}$'
done

publish_case a b
STUB_CARGO_UPLOADED_THEN_FAILS=a STUB_CARGO_FAILURE_AFTER_UPLOAD=cdn STUB_CARGO_UPLOAD_LOST=1 CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish that cargo fails with a 429 page of the index" 101 "cargo publish of a 0.1.0 failed with status 101" "" "${scripts}/publish" a b
expect_calls "publish that cargo fails with a 429 page of the index does not retry" 1 "cargo publish --no-verify -p a"
expect_no_call "publish that cargo fails with a 429 page of the index does not wait" '^sleep [0-9]{2,}$'

for signal in INT:130 TERM:143; do
    publish_case a b c
    mkdir -p "${case_dir}/tmp"
    STUB_CARGO_SIGNAL_ON=b STUB_CARGO_SIGNAL="${signal%:*}" TMPDIR="${case_dir}/tmp" CARGO_REGISTRY_TOKEN=fake-token-for-the-stub expect "publish on ${signal%:*}" "${signal#*:}" "interrupted while publishing b 0.1.0" "cargo publish --no-verify -p b" with_default_signals "${scripts}/publish" a b c
    check_output "publish on ${signal%:*} names the published" "published in this run: a"
    check_output "publish on ${signal%:*} names the rest" "not published: b c"
    expect_no_call "publish on ${signal%:*} stops" '^cargo publish --no-verify -p c$'
    expect_empty_tmp "publish on ${signal%:*} removes its temporary directory"
done

new_case
expect "publish-dry-run without packages" 2 "usage: publish-dry-run" "" "${scripts}/publish-dry-run"

new_case
STUB_CARGO_STATUS=101 expect "publish-dry-run that cargo fails" 101 "" "cargo publish --dry-run -p a -p b" "${scripts}/publish-dry-run" a b
if [[ -e "${case_dir}/target/publish-dry-run.commit" ]]; then
    failures=$((failures + 1))
    printf 'FAIL publish-dry-run that cargo fails\n    it wrote a record\n'
fi

new_case
record "${other_commit}" "old"
expect "publish-dry-run" 0 "recorded commit ${head_commit}" "cargo publish --dry-run -p a -p b" "${scripts}/publish-dry-run" a b
if [[ ! -f "${case_dir}/target/publish-dry-run.commit" || "$(cat "${case_dir}/target/publish-dry-run.commit")" != "$(printf 'commit=%s\npackages=a b' "${head_commit}")" ]]; then
    failures=$((failures + 1))
    printf 'FAIL publish-dry-run\n    the record differs\n'
fi


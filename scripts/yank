#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf '%s\n' "usage: CARGO_REGISTRY_TOKEN=<token> yank <package> <version>" "" \
        "Yanks one version of one package on crates.io with cargo yank. It refuses to" \
        "run when GITHUB_ACTIONS is set, because no workflow changes crates.io, and" \
        "when CARGO_REGISTRY_TOKEN is unset or empty." \
        "Exits 1 when it refuses, with the status of cargo when the yank fails, and" \
        "2 on a usage error or when cargo is missing."
}

if [[ $# -ne 2 || "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    [[ $# -ge 1 && ("$1" == "-h" || "$1" == "--help") ]] && exit 0
    exit 2
fi

if ! command -v cargo >/dev/null 2>&1; then
    printf 'yank: cargo not found on PATH\n' >&2
    exit 2
fi

if [[ -n "${GITHUB_ACTIONS+set}" ]]; then
    printf 'yank: %s\n' "GITHUB_ACTIONS is set, and no workflow changes crates.io, so only the owner runs this recipe in a terminal of their own" >&2
    exit 1
fi
if [[ -z "${CARGO_REGISTRY_TOKEN:-}" ]]; then
    printf 'yank: %s\n' "CARGO_REGISTRY_TOKEN is unset or empty, so pass a token that may yank on the command line of this one run" >&2
    exit 1
fi

cargo yank --version "$2" "$1"

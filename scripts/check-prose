#!/usr/bin/env -S python3 -I
import os
import re
import subprocess
import sys
from pathlib import Path

USAGE = """usage: check-prose [file.md ...]

Checks Markdown prose for non-ASCII characters, a UTF-8 byte order mark,
semicolons, and the non-Canadian spellings listed in
scripts/prose-wordlist.txt. Fenced code blocks and inline code spans are
ignored, and a code fence left open at the end of a file is a finding.
With no files, checks every Markdown file in the git repository that
contains the current directory, tracked or not ignored, and prints paths
relative to its root. Prints one path:line: message line per finding.
Exits 1 if there are findings, and 2 if a file cannot be read or the
setup is broken, after checking every readable file."""

FENCE_OPEN = re.compile(r"^\s*(`{3,}|~{3,})(.*)$")
BACKTICK_RUN = re.compile(r"`+")
BOM = "\ufeff"


class SetupError(Exception):
    pass


def load_words():
    wordlist = Path(__file__).resolve().parent / "prose-wordlist.txt"
    try:
        text = wordlist.read_text(encoding="utf-8")
    except OSError as error:
        raise SetupError(f"cannot read word list {wordlist}: {error.strerror}") from None
    words = [w.strip().lower() for w in text.splitlines()]
    words = [w for w in words if w]
    if not words:
        return None
    alternatives = "|".join(re.escape(w) for w in sorted(set(words), key=len, reverse=True))
    return re.compile(r"(?<![^\W_])(" + alternatives + r")(?![^\W_])", re.IGNORECASE)


def git(*args):
    try:
        result = subprocess.run(["git", *args], capture_output=True, check=False)
    except OSError as error:
        raise SetupError(f"cannot run git: {error.strerror}") from None
    if result.returncode != 0:
        message = result.stderr.decode("utf-8", "replace").strip().splitlines()
        raise SetupError(f"git {args[0]} failed: {message[0] if message else 'no output'}")
    return result.stdout.decode("utf-8", "surrogateescape")


def tracked_markdown():
    root = git("rev-parse", "--show-toplevel").rstrip("\n")
    os.chdir(root)
    output = git("ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", "*.md")
    names = [n for n in output.split("\0") if n]
    return [n for n in names if Path(n).is_file()]


def escaped(text, start):
    before = text[:start]
    return (len(before) - len(before.rstrip("\\"))) % 2 == 1


def prose_segments(lines):
    segments = []
    fence = None
    span = 0
    for number, line in enumerate(lines, start=1):
        if fence is not None:
            char, length, _ = fence
            stripped = line.strip()
            if len(stripped) >= length and stripped == char * len(stripped):
                fence = None
            continue
        if span == 0:
            match = FENCE_OPEN.match(line)
            if match and not (match.group(1)[0] == "`" and "`" in match.group(2)):
                fence = (match.group(1)[0], len(match.group(1)), number)
                continue
        if not line.strip():
            span = 0
            segments.append((number, line))
            continue
        kept = []
        position = 0
        for run in BACKTICK_RUN.finditer(line):
            start, end = run.start(), run.end()
            if span:
                if end - start == span:
                    span = 0
                    position = end
                continue
            if start < position:
                continue
            if escaped(line, start):
                start += 1
                if start == end:
                    continue
            length = end - start
            kept.append(line[position:start])
            if closes_later(lines, number - 1, end, length):
                span = length
            else:
                kept.append(line[start:end])
            position = end
        if not span:
            kept.append(line[position:])
        segments.append((number, "".join(kept)))
    unclosed = fence[2] if fence is not None else None
    return segments, unclosed


def closes_later(lines, index, start, length):
    current = lines[index][start:]
    candidates = [current]
    for following in lines[index + 1:]:
        if not following.strip() or FENCE_OPEN.match(following):
            break
        candidates.append(following)
    for text in candidates:
        for run in BACKTICK_RUN.finditer(text):
            if len(run.group(0)) == length:
                return True
    return False


def display(path):
    return path.replace("\n", "\\n").replace("\r", "\\r")


def check_file(path, words):
    findings = []
    shown = display(path)
    text = Path(path).read_text(encoding="utf-8", errors="surrogateescape")
    if text.startswith(BOM):
        findings.append((1, f"{shown}:1: UTF-8 byte order mark"))
        text = text[len(BOM):]
    segments, unclosed = prose_segments(text.splitlines())
    for number, prose in segments:
        for char in prose:
            code = ord(char)
            if 0xDC80 <= code <= 0xDCFF:
                findings.append((number, f"{shown}:{number}: invalid UTF-8 byte 0x{code - 0xDC00:02X}"))
            elif code > 0x7F:
                findings.append((number, f"{shown}:{number}: non-ASCII character U+{code:04X} {char!r}"))
            elif char == ";":
                findings.append((number, f"{shown}:{number}: semicolon"))
        if words is not None:
            for match in words.finditer(prose):
                findings.append((number, f"{shown}:{number}: non-Canadian spelling '{match.group(0)}'"))
    if unclosed is not None:
        findings.append((unclosed, f"{shown}:{unclosed}: unclosed code fence opened at line {unclosed}"))
    return [finding for _, finding in sorted(findings, key=lambda f: f[0])]


def emit(text, stream=sys.stdout):
    print(text.encode("ascii", "backslashreplace").decode("ascii"), file=stream)


def main(argv):
    if any(a in ("-h", "--help") for a in argv):
        print(USAGE)
        return 0
    try:
        words = load_words()
        paths = argv or tracked_markdown()
    except SetupError as error:
        emit(f"check-prose: {error}", sys.stderr)
        return 2
    findings = []
    unreadable = False
    for path in paths:
        try:
            findings.extend(check_file(path, words))
        except OSError as error:
            emit(f"check-prose: cannot read {display(path)}: {error.strerror}", sys.stderr)
            unreadable = True
    for finding in findings:
        emit(finding)
    if unreadable:
        return 2
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
